FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV PATH="$PATH:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/usr/local/bin"

RUN for i in 1 2 3 4 5; do apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk-headless unzip curl ca-certificates python3 python3-pip \
    perl make cmake ninja-build git build-essential \
    && rm -rf /var/lib/apt/lists/* && break; sleep 5; done

RUN pip3 install --no-cache-dir protobuf

COPY cache/protoc.zip /tmp/protoc.zip
RUN unzip -q /tmp/protoc.zip -d /tmp/protoc \
    && install -m 0755 /tmp/protoc/bin/protoc /usr/local/bin/protoc

COPY cache/cmdline.zip /tmp/cmdline.zip
RUN mkdir -p /opt/android-sdk/cmdline-tools \
    && unzip -q /tmp/cmdline.zip -d /opt/android-sdk/cmdline-tools \
    && mv /opt/android-sdk/cmdline-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest \
    && yes | sdkmanager --licenses >/dev/null 2>&1; true

RUN for i in 1 2 3; do sdkmanager --install "platforms;android-35" "platform-tools" "ndk;28.2.13676358" "cmake;3.22.1" && break; sleep 5; done

WORKDIR /src
CMD ["./gradlew", "assembleDebug"]
